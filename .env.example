# =============================================================================
# RemoteBridge Pro Studio - Environment Variables
# =============================================================================
# نسخة هذا الملف: .env.example
# قم بإنشاء ملف .env من هذا الملف وتعديل القيم حسب بيئتك

# خادم الإشارات (Signaling Server)
SIGNALING_SERVER_URL=wss://remotebridge1.onrender.com/ws
LOCAL_SIGNALING_URL=ws://10.0.2.2:10000/ws

# إعدادات خادم TURN (ضروري للاتصال خلف NAT وجدران الحماية)
TURN_SERVER_URL=turn:turn.remotebridge.app:3478?transport=udp
TURN_USERNAME=webrtcuser
TURN_PASSWORD=StrongTurnPassword2026!

# إعدادات خوادم STUN (備份)
STUN_SERVER_1=stun:stun.l.google.com:19302
STUN_SERVER_2=stun:stun1.l.google.com:19302
STUN_SERVER_3=stun:stun2.l.google.com:19302

# إعدادات Android
ANDROID_COMPILE_SDK=36
ANDROID_MIN_SDK=26
ANDROID_TARGET_SDK=36
ANDROID_VERSION_CODE=1
ANDROID_VERSION_NAME=1.0.0

# إعدادات التوقيع (Release)
KEYSTORE_PATH=${rootDir}/my-upload-key.jks
STORE_PASSWORD=your_keystore_password
KEY_ALIAS=upload
KEY_PASSWORD=your_key_password

# إعدادات النشر
RENDER_URL=wss://remotebridge1.onrender.com/ws
FLY_URL=wss://my-ai-bridge-app.fly.dev/ws

# توكنات المصادقة (للاستخدام مع MCP أو خوادم خارجية)
GITHUB_TOKEN=your_github_token_here
NOTION_TOKEN=your_notion_token_here

# =============================================================================
# ملاحظات:
# - لا تشارك ملف .env الحقيقي مع أي شخص
# - أضف .env إلى .gitignore لمنع رفعه إلى المستودع
# - استخدم {env:VAR_NAME} في إعدادات MCP للإشارة إلى هذه المتغيرات
# =============================================================================